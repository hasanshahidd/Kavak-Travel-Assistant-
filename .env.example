# =============================================================================
# Kavak Travel Assistant — Environment Configuration
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# =============================================================================

# --- LLM Provider ---
# Default provider: "openai" | "anthropic" | "mock"
# Use "mock" to demo without an API key (returns canned responses).
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE_DEFAULT=0
LLM_SEED=42

# --- API Keys (only the one matching LLM_PROVIDER is required) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Embeddings ---
EMBEDDINGS_MODEL=text-embedding-3-small

# --- Logging ---
LOG_LEVEL=INFO

# --- Tracing & observability ---
TRACE_DIR=./.traces
TRACE_REDACT_PII=true
